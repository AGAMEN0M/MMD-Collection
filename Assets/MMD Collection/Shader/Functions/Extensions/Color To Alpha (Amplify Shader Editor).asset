,\"1\",\"0\",\"COLOR\",\"0,0,0,1\",\"False\",\"1\",\"COLOR\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":10,\"pos\":[-1024,256],\"params\":[\"Inherit\",\"True\",\"Transparent Color\",\"5\",\"1\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"COLOR\",\"0,0,0,1\",\"False\",\"1\",\"COLOR\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.RangedFloatNode, AmplifyShaderEditor\",\"id\":4,\"pos\":[-1024,-384],\"params\":[\"Inherit\",\"True\",\"Property\",\"_Tolerance\",\"Tolerance\",\"2\",\"0\",\"Create\",\"True\",\"0\",\"0\",\"0\",\"False\",\"0\",\"False\",\"Object\",\"-1\",\"\",\"0.1\",\"0.1\",\"0\",\"1\",\"0\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":8,\"pos\":[-704,-384],\"params\":[\"Inherit\",\"True\",\"Tolerance\",\"1\",\"2\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SaturateNode, AmplifyShaderEditor\",\"id\":13,\"pos\":[-480,-384],\"params\":[\"Inherit\",\"True\",\"1\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SimpleSubtractOpNode, AmplifyShaderEditor\",\"id\":2,\"pos\":[-736,128],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"COLOR\",\"0,0,0,0\",\"False\",\"1\",\"COLOR\",\"0,0,0,0\",\"False\",\"1\",\"COLOR\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionOutput, AmplifyShaderEditor\",\"id\":0,\"pos\":[0,0],\"params\":[\"Inherit\",\"True\",\"True\",\"-1\",\"Alpha\",\"0\",\"False\",\"1\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"wire\":[5,0,13,0]}\n{\"wire\":[5,1,3,0]}\n{\"wire\":[3,0,2,0]}\n{\"wire\":[9,0,7,0]}\n{\"wire\":[10,0,1,0]}\n{\"wire\":[8,0,4,0]}\n{\"wire\":[13,0,8,0]}\n{\"wire\":[2,0,9,0]}\n{\"wire\":[2,1,10,0]}\n{\"wire\":[0,0,5,0]}\nASEEND*/\n//CHKSM=E85C4FF8C7AE9C71DB0DEAD219FF890DC0B9A519"
  m_functionName: 
  m_description: 'Creates an alpha mask by comparing a base color with a target transparent color.


    Uses a tolerance value to control cutoff sharpness.

    Outputs alpha only.'
