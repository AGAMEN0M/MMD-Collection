or.SimpleMaxOpNode, AmplifyShaderEditor\",\"id\":15,\"pos\":[-352,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":20,\"pos\":[-1536,0],\"params\":[\"Inherit\",\"True\",\"Ambient\",\"5\",\"2\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"COLOR\",\"1,1,1,0\",\"False\",\"1\",\"COLOR\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":21,\"pos\":[-1856,256],\"params\":[\"Inherit\",\"True\",\"Diffuse\",\"5\",\"3\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"COLOR\",\"0.8,0.8,0.8,0\",\"False\",\"1\",\"COLOR\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":22,\"pos\":[-1664,512],\"params\":[\"Inherit\",\"True\",\"Global Light Scale\",\"3\",\"0\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0.6,0.6,0.6\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.Vector3Node, AmplifyShaderEditor\",\"id\":17,\"pos\":[-1120,256],\"params\":[\"Inherit\",\"True\",\"Constant\",\"_Vector1\",\"Vector 0\",\"0\",\"0\",\"Create\",\"True\",\"0\",\"0\",\"0\",\"False\",\"0\",\"False\",\"Object\",\"-1\",\"\",\"1,1,1\",\"0,0,0\",\"0\",\"4\",\"FLOAT3\",\"0\",\"FLOAT\",\"1\",\"FLOAT\",\"2\",\"FLOAT\",\"3\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":23,\"pos\":[-864,256],\"params\":[\"Inherit\",\"True\",\"Weighted Ambient\",\"3\",\"1\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionOutput, AmplifyShaderEditor\",\"id\":0,\"pos\":[-96,0],\"params\":[\"Inherit\",\"True\",\"True\",\"-1\",\"Output\",\"0\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"wire\":[9,0,18,0]}\n{\"wire\":[9,1,8,0]}\n{\"wire\":[11,0,9,0]}\n{\"wire\":[11,1,17,0]