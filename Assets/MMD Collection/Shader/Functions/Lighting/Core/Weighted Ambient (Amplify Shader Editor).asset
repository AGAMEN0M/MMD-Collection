  m_Name: Weighted Ambient (Amplify Shader Editor)
  m_EditorClassIdentifier: AmplifyShaderEditor::AmplifyShaderEditor.AmplifyShaderFunction
  m_functionInfo: "// Made with Amplify Shader Editor v1.9.9.15\n// Available at the Unity Asset Store - http://u3d.as/y3X \n/*ASEBEGIN\nVersion=19915\n{\"type\":\"AmplifyShaderEditor.SimpleMultiplyOpNode, AmplifyShaderEditor\",\"id\":1,\"pos\":[-256,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":2,\"pos\":[-512,-128],\"params\":[\"Inherit\",\"True\",\"Global Ambient\",\"3\",\"0\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":3,\"pos\":[-512,128],\"params\":[\"Inherit\",\"True\",\"Ambient Blend Factor\",\"3\",\"1\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionOutput, AmplifyShaderEditor\",\"id\":0,\"pos\":[0,0],\"params\":[\"Inherit\",\"True\",\"True\",\"-1\",\"Output\",\"0\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"wire\":[1,0,2,0]}\n{\"wire\":[1,1,3,0]}\n{\"wire\":[0,0,1,0]}\nASEEND*/\n//CHKSM=FDC34734381260745EF1B36EAEBCDC0C8C013580"
  m_functionName: 
  m_description: 'Computes the weighted ambient lighting contribution.

    Multiplies the global ambient color by the ambient blend factor to produce a scaled ambient term for final lighting composition.'
