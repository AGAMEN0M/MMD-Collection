  m_functionInfo: "// Made with Amplify Shader Editor v1.9.9.15\n// Available at the Unity Asset Store - http://u3d.as/y3X \n/*ASEBEGIN\nVersion=19915\n{\"type\":\"AmplifyShaderEditor.SimpleMultiplyOpNode, AmplifyShaderEditor\",\"id\":6,\"pos\":[-256,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SimpleMaxOpNode, AmplifyShaderEditor\",\"id\":5,\"pos\":[-512,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SimpleSubtractOpNode, AmplifyShaderEditor\",\"id\":4,\"pos\":[-768,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":13,\"pos\":[-1280,128],\"params\":[\"Inherit\",\"True\",\"Ambient\",\"5\",\"2\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"COLOR\",\"1,1,1,0\",\"False\",\"1\",\"COLOR\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SwizzleNode, AmplifyShaderEditor\",\"id\":14,\"pos\":[-1024,128],\"params\":[\"Inherit\",\"True\",\"FLOAT3\",\"0\",\"1\",\"2\",\"3\",\"1\",\"0\",\"COLOR\",\"0,0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":12,\"pos\":[-1024,-256],\"params\":[\"Inherit\",\"True\",\"Toon Light Pivot\",\"3\",\"0\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0.5,0.5,0.5\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.Vector3Node, AmplifyShaderEditor\",\"id\":3,\"pos\":[-768,256],\"params\":[\"Inherit\",\"True\",\"Constant\",\"_Vector0\",\"Vector 0\",\"3\",\"0\",\"Create\",\"True\",\"0\",\"0\",\"0\",\"False\",\"0\",\"False\",\"Object\",\"-1\",\"\",\"0,0,0\",\"0,0,0\",\"0\",\"4\",\"FLOAT3\",\"0\",\"FLOAT\",\"1\",\"FLOAT\",\"2\",\"FLOAT\",\"3\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":11,\"pos\":[-512,256],\"params\":[\"Inherit\",\"True\",\"Toon Light Pivot Inv\",\"3\",\"1\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT3\",\"1,1,1\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionOutput, AmplifyShaderEditor\",\"id\":0,\"pos\":[0,0],\"params\":[\"Inherit\",\"True\",\"True\",\"-1\",\"Output\",\"0\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"wire\":[6,0,5,0]}\n{\"wire\":[6,1,11,0]}\n{\"wire\":[5,0,4,0]}\n{\"wire\":[5,1,3,0]}\n{\"wire\":[4,0,12,0]}\n{\"wire\":[4,1,14,0]}\n{\"wire\":[14,0,13,0]}\n{\"wire\":[0,0,6,0]}\nASEEND*/\n//CHKSM=39A09F1B1B56E535F8619B8CED32EC49860602D4"
  m_functionName: 
  m_description: 'Computes an ambient lighting adjustment relative to a toon light pivot.

    Offsets the ambient color from the pivot, clamps negative values, and rescales the result using the inverse pivot to produce a normalized ambient adjustment term.'
