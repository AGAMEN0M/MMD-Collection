  m_Name: Ambient Blend Factor (Amplify Shader Editor)
  m_EditorClassIdentifier: AmplifyShaderEditor::AmplifyShaderEditor.AmplifyShaderFunction
  m_functionInfo: "// Made with Amplify Shader Editor v1.9.9.15\n// Available at the Unity Asset Store - http://u3d.as/y3X \n/*ASEBEGIN\nVersion=19915\n{\"type\":\"AmplifyShaderEditor.Vector3Node, AmplifyShaderEditor\",\"id\":4,\"pos\":[-288,0],\"params\":[\"Inherit\",\"False\",\"Constant\",\"_Vector0\",\"Vector 0\",\"33\",\"0\",\"Create\",\"True\",\"0\",\"0\",\"0\",\"False\",\"0\",\"False\",\"Object\",\"-1\",\"\",\"1,1,1\",\"0,0,0\",\"0\",\"4\",\"FLOAT3\",\"0\",\"FLOAT\",\"1\",\"FLOAT\",\"2\",\"FLOAT\",\"3\"]}\n{\"type\":\"AmplifyShaderEditor.SimpleSubtractOpNode, AmplifyShaderEditor\",\"id\":6,\"pos\":[-96,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":7,\"pos\":[-384,192],\"params\":[\"Inherit\",\"True\",\"Ambient Pivot Adjustment\",\"3\",\"0\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionOutput, AmplifyShaderEditor\",\"id\":0,\"pos\":[160,0],\"params\":[\"Inherit\",\"True\",\"True\",\"-1\",\"Output\",\"0\",\"False\",\"1\",\"0\",\"FLOAT3\",\"0,0,0\",\"False\",\"1\",\"FLOAT3\",\"0\"]}\n{\"wire\":[6,0,4,0]}\n{\"wire\":[6,1,7,0]}\n{\"wire\":[0,0,6,0]}\nASEEND*/\n//CHKSM=A853D1070EDB87EFB7FC9643D1D79025854185F1"
  m_functionName: 
  m_description: 'Computes an ambient blend factor by inverting the ambient pivot adjustment.

    Subtracts the normalized ambient adjustment from one to produce a weighting value suitable for ambient-to-light blending.'
