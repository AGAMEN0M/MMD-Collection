  m_functionInfo: "// Made with Amplify Shader Editor v1.9.9.15\n// Available at the Unity Asset Store - http://u3d.as/y3X \n/*ASEBEGIN\nVersion=19915\n{\"type\":\"AmplifyShaderEditor.RangedFloatNode, AmplifyShaderEditor\",\"id\":2,\"pos\":[-800,256],\"params\":[\"Inherit\",\"False\",\"Constant\",\"_Float3\",\"Float 3\",\"33\",\"0\",\"Create\",\"True\",\"0\",\"0\",\"0\",\"False\",\"0\",\"False\",\"Object\",\"-1\",\"\",\"2\",\"0\",\"0\",\"0\",\"0\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SimpleMultiplyOpNode, AmplifyShaderEditor\",\"id\":3,\"pos\":[-608,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SimpleMultiplyOpNode, AmplifyShaderEditor\",\"id\":4,\"pos\":[-352,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SimpleSubtractOpNode, AmplifyShaderEditor\",\"id\":6,\"pos\":[-96,0],\"params\":[\"Inherit\",\"True\",\"2\",\"2\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.SaturateNode, AmplifyShaderEditor\",\"id\":7,\"pos\":[128,0],\"params\":[\"Inherit\",\"True\",\"1\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.RangedFloatNode, AmplifyShaderEditor\",\"id\":5,\"pos\":[-320,256],\"params\":[\"Inherit\",\"False\",\"Constant\",\"_Float4\",\"Float 4\",\"33\",\"0\",\"Create\",\"True\",\"0\",\"0\",\"0\",\"False\",\"0\",\"False\",\"Object\",\"-1\",\"\",\"1\",\"0\",\"0\",\"0\",\"0\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionInput, AmplifyShaderEditor\",\"id\":1,\"pos\":[-896,0],\"params\":[\"Inherit\",\"True\",\"Clamped Light Response\",\"1\",\"0\",\"False\",\"\",\"\",\"\",\"\",\"False\",\"1\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"type\":\"AmplifyShaderEditor.FunctionOutput, AmplifyShaderEditor\",\"id\":0,\"pos\":[320,0],\"params\":[\"Inherit\",\"True\",\"True\",\"-1\",\"Output\",\"0\",\"False\",\"1\",\"0\",\"FLOAT\",\"0\",\"False\",\"1\",\"FLOAT\",\"0\"]}\n{\"wire\":[3,0,1,0]}\n{\"wire\":[3,1,2,0]}\n{\"wire\":[4,0,3,0]}\n{\"wire\":[4,1,3,0]}\n{\"wire\":[6,0,4,0]}\n{\"wire\":[6,1,5,0]}\n{\"wire\":[7,0,6,0]}\n{\"wire\":[0,0,7,0]}\nASEEND*/\n//CHKSM=51A136EE836FCBD4FF0FD6F39188842F96CDDA16"
  m_functionName: 
  m_description: 'Generates a stylized toon shadow mask from a clamped light response.

    The function amplifies the input, applies a quadratic shaping curve, and outputs a saturated mask suitable for MMD-style toon shading.'
